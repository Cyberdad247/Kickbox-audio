{
  "name": "sovereign-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "description": "Sovereign System monorepo — PWA + Bifrost gateway + Prisma DB (Vault_Ω / Raven_Ω / Echo_Ω)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npx turbo run build && node -e \"const fs=require('fs'); if(fs.existsSync('apps/pwa/dist')){fs.cpSync('apps/pwa/dist', 'dist', {recursive: true, force: true}); console.log('✓ Artifacts copied to root dist/');}\"",
    "build:all": "npm run build --workspace=@sovereign/db && npm run build --workspace=bifrost && npm run build --workspace=pwa",
    "dev": "npx turbo run dev",
    "typecheck": "npx turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vault": "vitest run packages/db/src/ledgerValidator.test.ts",
    "test:bifrost": "vitest run apps/bifrost/src/server.test.ts",
    "test:voice": "vitest run apps/bifrost/src/state.test.ts",
    "db:generate": "npm run generate --workspace=@sovereign/db",
    "db:migrate": "npm run migrate --workspace=@sovereign/db",
    "db:migrate:dev": "npm run migrate:dev --workspace=@sovereign/db",
    "db:seed": "npm run seed --workspace=@sovereign/db",
    "benchmark": "npm run start --workspace=@sovereign/benchmark"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.6",
    "prisma": "^5.22.0",
    "turbo": "^2.3.3",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@types/three": "0.185.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-list": "^3.30.1",
    "firebase": "^12.18.0",
    "i18next": "^26.4.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "zustand": "^5.0.15"
  }
}