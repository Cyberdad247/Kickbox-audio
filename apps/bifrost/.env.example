# Bifrost gateway configuration.
PORT=3001

# Shared secret for verifying inbound SMS/webhook HMAC-SHA256 signatures
# (header: x-webhook-signature). Set this to the secret configured at your
# telecom provider (Telnyx / Bandwidth).
# ALSO used for the PWA→CMS proxy HMAC mint+verify chain (see /api/bifrost/proxy-sign
# and requireBifrostProxySignature in src/security.ts).
WEBHOOK_SECRET=change-me

# Prisma database connection (used by @sovereign/db).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sovereign?schema=public&connection_limit=5"

# Local SMTP relay config (consumed by apps/bifrost/src/smtpRelay.ts).
# Safe-by-default: AALIYAH_MTA_DRY_RUN only opts OUT when explicitly '0' or 'false'.
# In production with no env var, dispatches also dry-run (fail safe).
AALIYAH_MTA_HOST=127.0.0.1
AALIYAH_MTA_PORT=25
# AALIYAH_MTA_FROM=lakisha@kickbox.audio
# AALIYAH_MTA_DRY_RUN=0
