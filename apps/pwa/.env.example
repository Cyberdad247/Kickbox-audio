# Bifrost WebSocket gateway URL the PWA connects to.
# Local dev default is ws://localhost:3001; in production point at the Railway host (wss://).
NEXT_PUBLIC_BIFROST_URL=ws://localhost:3001

# Optional override for server-side API proxy calls from the PWA to the Bifrost
# HTTP surface. When unset, the PWA derives this from NEXT_PUBLIC_BIFROST_URL
# (ws -> http, wss -> https).
# BIFROST_HTTP_URL=http://127.0.0.1:3001

# Note: there is no separate proxy-secret env var any more. The PWA's CMS proxy
# fetches a short-lived HMAC bundle from /api/bifrost/proxy-sign on each cache
# miss (10-min TTL) and attaches x-webhook-{action,signature,timestamp,expires-at}
# headers to every /api/cms/* upstream call. Bifrost verifies using WEBHOOK_SECRET.
